@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 text-center">
        <div class="card card-modern p-5 border-0 shadow-lg">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-x display-1"></i>
            </div>
            <h2 class="fw-bold mb-2">Access Denied (403)</h2>
            <p class="text-muted mb-4">
                You do not have sufficient permissions to access this page or perform this action.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                    <i class="bi bi-house me-1"></i> Return Home
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Switch Account
                </a>
            </div>
        </div>
    </div>
</div>
