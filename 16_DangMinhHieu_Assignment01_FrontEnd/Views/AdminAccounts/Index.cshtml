@model List<BusinessObjects.Entities.SystemAccount>
@{
    ViewData["Title"] = "Account Management";
    string? searchKeyword = ViewBag.SearchKeyword;
    int? selectedRole = ViewBag.SelectedRole;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-people text-primary me-2"></i>Account Management</h2>
        <p class="text-muted small mb-0">Create, update, search, and manage system accounts</p>
    </div>
    <button type="button" class="btn btn-primary" onclick="openCreateModal()">
        <i class="bi bi-person-plus-fill me-1"></i> Create Account
    </button>
</div>

<!-- Search & Filter Card -->
<div class="card card-modern p-3 mb-4 border-0">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@searchKeyword" class="form-control" placeholder="Search by account name or email..." />
            </div>
        </div>
        <div class="col-md-4">
            <select name="role" class="form-select" onchange="this.form.submit()">
                <option value="">-- All Roles --</option>
                <option value="1" selected="@(selectedRole == 1 ? "selected" : null)">Staff</option>
                <option value="2" selected="@(selectedRole == 2 ? "selected" : null)">Lecturer</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
            @if (!string.IsNullOrEmpty(searchKeyword) || selectedRole.HasValue)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-x-circle"></i></a>
            }
        </div>
    </form>
</div>

<!-- Accounts Table -->
<div class="card card-modern border-0">
    <div class="table-responsive">
        <table class="table table-modern mb-0">
            <thead>
                <tr>
                    <th>Account ID</th>
                    <th>Full Name</th>
                    <th>Email Address</th>
                    <th>System Role</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-person-x fs-1 d-block mb-2"></i>
                            No accounts found matching the criteria.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var acc in Model)
                    {
                        var roleBadge = acc.AccountRole switch
                        {
                            1 => "badge-staff",
                            2 => "badge-lecturer",
                            _ => "badge-role bg-secondary text-white"
                        };
                        var roleText = acc.AccountRole switch
                        {
                            1 => "Staff",
                            2 => "Lecturer",
                            _ => "User"
                        };

                        <tr>
                            <td class="fw-bold text-muted">#@acc.AccountId</td>
                            <td class="fw-semibold text-dark">@acc.AccountName</td>
                            <td>@acc.AccountEmail</td>
                            <td>
                                <span class="badge-role @roleBadge">@roleText</span>
                            </td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="openEditModal(@acc.AccountId)">
                                    <i class="bi bi-pencil-square me-1"></i> Edit
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDeleteAccount(@acc.AccountId, '@acc.AccountName')">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- CREATE ACCOUNT MODAL -->
<div class="modal fade" id="createAccountModal" tabindex="-1" aria-labelledby="createAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="createAccountModalLabel">
                    <i class="bi bi-person-plus text-primary me-2"></i>Create New Account
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createAccountForm" onsubmit="submitCreateAccount(event)">
                <div class="modal-body p-4">
                    <div id="createAccountAlert" class="alert alert-danger d-none py-2 small"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Full Name <span class="text-danger">*</span></label>
                        <input type="text" id="createAccountName" class="form-control" placeholder="e.g. John Doe" required maxlength="100" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Email Address <span class="text-danger">*</span></label>
                        <input type="email" id="createAccountEmail" class="form-control" placeholder="e.g. johndoe@FUNewsManagement.org" required maxlength="70" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Password <span class="text-danger">*</span></label>
                        <input type="password" id="createAccountPassword" class="form-control" placeholder="Enter password" required maxlength="70" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Role <span class="text-danger">*</span></label>
                        <select id="createAccountRole" class="form-select" required>
                            <option value="">-- Select Role --</option>
                            <option value="1">Staff (Role 1)</option>
                            <option value="2">Lecturer (Role 2)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnSubmitCreateAccount">
                        <i class="bi bi-check-circle me-1"></i> Save Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EDIT ACCOUNT MODAL -->
<div class="modal fade" id="editAccountModal" tabindex="-1" aria-labelledby="editAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="editAccountModalLabel">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Edit Account
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editAccountForm" onsubmit="submitEditAccount(event)">
                <div class="modal-body p-4">
                    <div id="editAccountAlert" class="alert alert-danger d-none py-2 small"></div>
                    <input type="hidden" id="editAccountId" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Full Name <span class="text-danger">*</span></label>
                        <input type="text" id="editAccountName" class="form-control" required maxlength="100" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Email Address <span class="text-danger">*</span></label>
                        <input type="email" id="editAccountEmail" class="form-control" required maxlength="70" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">New Password <span class="text-muted fw-normal">(Optional)</span></label>
                        <input type="password" id="editAccountPassword" class="form-control" placeholder="Leave blank to keep existing password" maxlength="70" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Role <span class="text-danger">*</span></label>
                        <select id="editAccountRole" class="form-select" required>
                            <option value="1">Staff (Role 1)</option>
                            <option value="2">Lecturer (Role 2)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnSubmitEditAccount">
                        <i class="bi bi-check-circle me-1"></i> Update Account
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const createModal = new bootstrap.Modal(document.getElementById('createAccountModal'));
        const editModal = new bootstrap.Modal(document.getElementById('editAccountModal'));

        function openCreateModal() {
            document.getElementById('createAccountForm').reset();
            $('#createAccountAlert').addClass('d-none').text('');
            createModal.show();
        }

        async function submitCreateAccount(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitCreateAccount');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';

            const payload = {
                accountName: document.getElementById('createAccountName').value.trim(),
                accountEmail: document.getElementById('createAccountEmail').value.trim(),
                accountPassword: document.getElementById('createAccountPassword').value,
                accountRole: parseInt(document.getElementById('createAccountRole').value)
            };

            try {
                const response = await fetch('/AdminAccounts/Create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                if (response.ok && result.success) {
                    createModal.hide();
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: result.message || 'Account created successfully!',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => location.reload());
                } else {
                    $('#createAccountAlert').removeClass('d-none').text(result.message || 'Failed to create account.');
                }
            } catch (err) {
                $('#createAccountAlert').removeClass('d-none').text('Error connecting to server.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Save Account';
            }
        }

        async function openEditModal(id) {
            $('#editAccountAlert').addClass('d-none').text('');
            try {
                const res = await fetch(`/AdminAccounts/GetAccount?id=${id}`);
                if (!res.ok) {
                    Swal.fire('Error', 'Unable to fetch account details.', 'error');
                    return;
                }
                const data = await res.json();
                document.getElementById('editAccountId').value = data.accountId;
                document.getElementById('editAccountName').value = data.accountName || '';
                document.getElementById('editAccountEmail').value = data.accountEmail || '';
                document.getElementById('editAccountPassword').value = '';
                document.getElementById('editAccountRole').value = data.accountRole || 1;

                editModal.show();
            } catch (err) {
                Swal.fire('Error', 'Failed to load account.', 'error');
            }
        }

        async function submitEditAccount(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitEditAccount');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Updating...';

            const payload = {
                accountId: parseInt(document.getElementById('editAccountId').value),
                accountName: document.getElementById('editAccountName').value.trim(),
                accountEmail: document.getElementById('editAccountEmail').value.trim(),
                accountPassword: document.getElementById('editAccountPassword').value || null,
                accountRole: parseInt(document.getElementById('editAccountRole').value)
            };

            try {
                const response = await fetch('/AdminAccounts/Update', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                if (response.ok && result.success) {
                    editModal.hide();
                    Swal.fire({
                        icon: 'success',
                        title: 'Updated!',
                        text: result.message || 'Account updated successfully!',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => location.reload());
                } else {
                    $('#editAccountAlert').removeClass('d-none').text(result.message || 'Failed to update account.');
                }
            } catch (err) {
                $('#editAccountAlert').removeClass('d-none').text('Error connecting to server.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Update Account';
            }
        }

        function confirmDeleteAccount(id, name) {
            Swal.fire({
                title: 'Delete Account?',
                text: `Are you sure you want to delete account "${name}" (ID #${id})?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Delete',
                cancelButtonText: 'Cancel'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`/AdminAccounts/Delete?id=${id}`, {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': getAntiForgeryToken()
                            }
                        });

                        const resJson = await response.json();
                        if (response.ok && resJson.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: resJson.message || 'Account deleted successfully.',
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => location.reload());
                        } else {
                            // Display delete restriction descriptive error (400 Bad Request)
                            Swal.fire({
                                icon: 'error',
                                title: 'Cannot Delete Account',
                                text: resJson.message || 'Cannot delete this account.',
                                confirmButtonColor: '#4f46e5'
                            });
                        }
                    } catch (err) {
                        Swal.fire('Error', 'Unable to complete deletion request.', 'error');
                    }
                }
            });
        }
    </script>
}
