@model List<BusinessObjects.Entities.NewsArticle>
@{
    ViewData["Title"] = "News Portal";
    var categories = ViewBag.Categories as List<BusinessObjects.Entities.Category> ?? new List<BusinessObjects.Entities.Category>();
    short? selectedCategory = ViewBag.SelectedCategory;
    string? searchKeyword = ViewBag.SearchKeyword;
}

<div class="hero-banner">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <span class="badge bg-white text-primary mb-2 fw-semibold px-3 py-2 rounded-pill">
                <i class="bi bi-broadcast me-1"></i> Official Campus Portal
            </span>
            <h1 class="display-5 fw-bold mb-3">Welcome to FU News Management</h1>
            <p class="lead mb-0 text-white-50">
                Discover breaking news, academic achievements, research initiatives, campus events, and university spotlights.
            </p>
        </div>
        <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-light btn-lg px-4 fw-bold shadow-sm">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Manage
                </a>
            }
            else
            {
                <span class="text-white-50">Logged in as <strong class="text-white">@User.Identity?.Name</strong></span>
            }
        </div>
    </div>
</div>

<!-- Search & Filter Controls -->
<div class="card card-modern mb-4 p-3 border-0">
    <form method="get" asp-controller="Home" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@searchKeyword" class="form-control border-start-0 ps-0" placeholder="Search headline, content, tags, source..." />
            </div>
        </div>
        <div class="col-md-4">
            <select name="categoryId" class="form-select" onchange="this.form.submit()">
                <option value="">-- All Categories --</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.CategoryId" selected="@(selectedCategory == cat.CategoryId ? "selected" : null)">
                        @cat.CategoryName
                    </option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-funnel me-1"></i> Filter
            </button>
            @if (!string.IsNullOrEmpty(searchKeyword) || selectedCategory.HasValue)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear filters">
                    <i class="bi bi-x-circle"></i>
                </a>
            }
        </div>
    </form>
</div>

<!-- Articles Grid -->
<div class="row g-4">
    @if (Model == null || !Model.Any())
    {
        <div class="col-12">
            <div class="card card-modern p-5 text-center">
                <i class="bi bi-newspaper display-3 text-muted mb-3"></i>
                <h4 class="fw-bold">No News Articles Found</h4>
                <p class="text-muted">No news matched your search or category filter criteria. Try adjusting your query.</p>
                <div>
                    <a asp-action="Index" class="btn btn-outline-primary btn-sm">Reset Filters</a>
                </div>
            </div>
        </div>
    }
    else
    {
        @foreach (var article in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card card-modern h-100 d-flex flex-column">
                    <div class="card-body d-flex flex-column p-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1 small fw-semibold">
                                <i class="bi bi-folder me-1"></i> @(article.Category?.CategoryName ?? "General")
                            </span>
                            <small class="text-muted">
                                <i class="bi bi-calendar3 me-1"></i>
                                @(article.CreatedDate?.ToString("MMM dd, yyyy") ?? "Recent")
                            </small>
                        </div>

                        <h5 class="card-title fw-bold text-dark mt-2 mb-2 line-clamp-2">
                            <a asp-action="Details" asp-route-id="@article.NewsArticleId" class="text-decoration-none text-dark hover-primary">
                                @article.Headline
                            </a>
                        </h5>

                        @if (!string.IsNullOrWhiteSpace(article.NewsTitle) && article.NewsTitle != article.Headline)
                        {
                            <h6 class="text-muted small mb-2 fst-italic">@article.NewsTitle</h6>
                        }

                        <p class="card-text text-secondary small flex-grow-1 mb-3">
                            @{
                                var content = article.NewsContent ?? "";
                                if (content.Length > 150)
                                {
                                    content = content.Substring(0, 150) + "...";
                                }
                            }
                            @content
                        </p>

                        <!-- Tags -->
                        @if (article.Tags != null && article.Tags.Any())
                        {
                            <div class="d-flex flex-wrap gap-1 mb-3">
                                @foreach (var tag in article.Tags.Take(4))
                                {
                                    <span class="badge-tag">#@tag.TagName</span>
                                }
                                @if (article.Tags.Count > 4)
                                {
                                    <span class="badge-tag text-muted">+@(article.Tags.Count - 4)</span>
                                }
                            </div>
                        }

                        <div class="border-top pt-3 mt-auto d-flex justify-content-between align-items-center">
                            <div class="small text-muted d-flex align-items-center gap-1">
                                <i class="bi bi-person-circle"></i>
                                <span>@(article.CreatedBy?.AccountName ?? "Campus Editor")</span>
                            </div>
                            <a asp-action="Details" asp-route-id="@article.NewsArticleId" class="btn btn-sm btn-outline-primary fw-semibold">
                                Read More <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>
