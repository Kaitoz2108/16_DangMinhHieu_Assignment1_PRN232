@model List<BusinessObjects.Entities.NewsArticle>
@{
    ViewData["Title"] = "News Articles Report";
    string? startDate = ViewBag.StartDate;
    string? endDate = ViewBag.EndDate;
    int total = ViewBag.TotalArticles ?? 0;
    int active = ViewBag.ActiveCount ?? 0;
    int inactive = ViewBag.InactiveCount ?? 0;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-graph-up text-primary me-2"></i>News Articles Report</h2>
        <p class="text-muted small mb-0">Statistical report and audit of university news articles created within date ranges</p>
    </div>
    <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
        <i class="bi bi-printer me-1"></i> Print / Export Report
    </button>
</div>

<!-- Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon bg-primary-subtle text-primary">
                <i class="bi bi-journal-check"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em;">Total Articles</div>
                <div class="fs-2 fw-bold text-dark">@total</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon bg-success-subtle text-success">
                <i class="bi bi-check-circle"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em;">Active / Published</div>
                <div class="fs-2 fw-bold text-success">@active</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="stat-icon bg-secondary-subtle text-secondary">
                <i class="bi bi-pause-circle"></i>
            </div>
            <div>
                <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em;">Draft / Inactive</div>
                <div class="fs-2 fw-bold text-secondary">@inactive</div>
            </div>
        </div>
    </div>
</div>

<!-- Date Range Filter Form -->
<div class="card card-modern p-4 mb-4 border-0">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label fw-semibold small text-muted">Start Date</label>
            <div class="input-group">
                <span class="input-group-text bg-white text-muted"><i class="bi bi-calendar-event"></i></span>
                <input type="date" name="startDate" value="@startDate" class="form-control" />
            </div>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold small text-muted">End Date</label>
            <div class="input-group">
                <span class="input-group-text bg-white text-muted"><i class="bi bi-calendar-check"></i></span>
                <input type="date" name="endDate" value="@endDate" class="form-control" />
            </div>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-filter me-1"></i> Generate Report
            </button>
            @if (!string.IsNullOrEmpty(startDate) || !string.IsNullOrEmpty(endDate))
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset date filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            }
        </div>
    </form>
</div>

<!-- Report Table -->
<div class="card card-modern border-0">
    <div class="card-header bg-white p-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-muted">
            <i class="bi bi-table me-1"></i> Report Results (Ordered by Created Date Descending)
        </h6>
        <span class="badge bg-light text-dark border">@total records found</span>
    </div>
    <div class="table-responsive">
        <table class="table table-modern mb-0">
            <thead>
                <tr>
                    <th>Article ID</th>
                    <th>Headline</th>
                    <th>Category</th>
                    <th>Author</th>
                    <th>Created Date</th>
                    <th>Last Modified</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox display-4 d-block mb-2"></i>
                            No articles found for the selected date range.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var article in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">#@article.NewsArticleId</td>
                            <td>
                                <div class="fw-semibold text-dark">@article.Headline</div>
                                @if (!string.IsNullOrWhiteSpace(article.NewsSource))
                                {
                                    <div class="small text-muted">Source: @article.NewsSource</div>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(article.Category?.CategoryName ?? "General")
                                </span>
                            </td>
                            <td>
                                <div class="small fw-semibold">@(article.CreatedBy?.AccountName ?? "Staff")</div>
                                <div class="small text-muted">ID: #@article.CreatedById</div>
                            </td>
                            <td class="small text-muted">
                                @(article.CreatedDate?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")
                            </td>
                            <td class="small text-muted">
                                @(article.ModifiedDate?.ToString("yyyy-MM-dd HH:mm") ?? "-")
                            </td>
                            <td>
                                @if (article.NewsStatus == true)
                                {
                                    <span class="badge-status-active">Active</span>
                                }
                                else
                                {
                                    <span class="badge-status-inactive">Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
