@model List<BusinessObjects.Entities.NewsArticle>
@{
    ViewData["Title"] = "News Articles Management";
    string? searchKeyword = ViewBag.SearchKeyword;
    short? selectedCategory = ViewBag.SelectedCategory;
    bool? selectedStatus = ViewBag.SelectedStatus;
    var categories = ViewBag.Categories as List<BusinessObjects.Entities.Category> ?? new List<BusinessObjects.Entities.Category>();
    var tags = ViewBag.Tags as List<BusinessObjects.Entities.Tag> ?? new List<BusinessObjects.Entities.Tag>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-journal-text text-primary me-2"></i>News Articles Management</h2>
        <p class="text-muted small mb-0">Create, edit, classify, tag, and publish university news articles</p>
    </div>
    <button type="button" class="btn btn-primary" onclick="openCreateModal()">
        <i class="bi bi-plus-circle me-1"></i> Create News Article
    </button>
</div>

<!-- Search & Filter Card -->
<div class="card card-modern p-3 mb-4 border-0">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-white text-muted"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@searchKeyword" class="form-control" placeholder="Search headline, content, tags..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="categoryId" class="form-select" onchange="this.form.submit()">
                <option value="">-- All Categories --</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.CategoryId" selected="@(selectedCategory == cat.CategoryId ? "selected" : null)">
                        @cat.CategoryName
                    </option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select" onchange="this.form.submit()">
                <option value="">-- All Statuses --</option>
                <option value="true" selected="@(selectedStatus == true ? "selected" : null)">Active Only</option>
                <option value="false" selected="@(selectedStatus == false ? "selected" : null)">Inactive Only</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
            @if (!string.IsNullOrEmpty(searchKeyword) || selectedCategory.HasValue || selectedStatus.HasValue)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-x-circle"></i></a>
            }
        </div>
    </form>
</div>

<!-- News Table -->
<div class="card card-modern border-0">
    <div class="table-responsive">
        <table class="table table-modern mb-0">
            <thead>
                <tr>
                    <th>Article ID</th>
                    <th>Headline</th>
                    <th>Category</th>
                    <th>Author</th>
                    <th>Created Date</th>
                    <th>Status</th>
                    <th>Tags</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-newspaper fs-1 d-block mb-2"></i>
                            No news articles found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var article in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">#@article.NewsArticleId</td>
                            <td style="max-width: 280px;">
                                <div class="fw-semibold text-dark text-truncate" title="@article.Headline">
                                    @article.Headline
                                </div>
                                @if (!string.IsNullOrWhiteSpace(article.NewsSource))
                                {
                                    <div class="small text-muted text-truncate">Source: @article.NewsSource</div>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(article.Category?.CategoryName ?? "General")
                                </span>
                            </td>
                            <td class="small">
                                <i class="bi bi-person me-1 text-primary"></i>
                                @(article.CreatedBy?.AccountName ?? "Staff")
                            </td>
                            <td class="small text-muted">
                                @(article.CreatedDate?.ToString("MMM dd, yyyy") ?? "N/A")
                            </td>
                            <td>
                                @if (article.NewsStatus == true)
                                {
                                    <span class="badge-status-active">Active</span>
                                }
                                else
                                {
                                    <span class="badge-status-inactive">Inactive</span>
                                }
                            </td>
                            <td style="max-width: 180px;">
                                @if (article.Tags != null && article.Tags.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var tag in article.Tags.Take(3))
                                        {
                                            <span class="badge-tag">#@tag.TagName</span>
                                        }
                                        @if (article.Tags.Count > 3)
                                        {
                                            <span class="badge-tag text-muted">+@(article.Tags.Count - 3)</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">No tags</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-controller="Home" asp-action="Details" asp-route-id="@article.NewsArticleId" class="btn btn-sm btn-outline-info me-1" title="View details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="openEditModal('@article.NewsArticleId')">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDeleteArticle('@article.NewsArticleId', '@Html.Raw(JavaScriptEncoder.Default.Encode(article.Headline))')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- CREATE ARTICLE MODAL -->
<div class="modal fade" id="createArticleModal" tabindex="-1" aria-labelledby="createArticleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="createArticleModalLabel">
                    <i class="bi bi-plus-circle text-primary me-2"></i>Create News Article
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="createArticleForm" onsubmit="submitCreateArticle(event)">
                <div class="modal-body p-4">
                    <div id="createArticleAlert" class="alert alert-danger d-none py-2 small"></div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Headline <span class="text-danger">*</span></label>
                        <input type="text" id="createHeadline" class="form-control" placeholder="Enter compelling headline..." required maxlength="150" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Secondary Title / Subhead</label>
                        <input type="text" id="createNewsTitle" class="form-control" placeholder="Optional subtitle..." maxlength="400" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Category <span class="text-danger">*</span></label>
                            <select id="createCategoryId" class="form-select" required>
                                <option value="">-- Select Category --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.CategoryId">@cat.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">News Source</label>
                            <input type="text" id="createNewsSource" class="form-control" placeholder="e.g. University Press, Reuters" maxlength="400" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">News Content</label>
                        <textarea id="createNewsContent" class="form-control" rows="5" placeholder="Article full text..." maxlength="4000"></textarea>
                    </div>

                    <!-- Tags Checkboxes -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small d-block">Tags Selection</label>
                        <div class="border rounded p-3 bg-light d-flex flex-wrap gap-3" style="max-height: 120px; overflow-y: auto;">
                            @foreach (var tag in tags)
                            {
                                <div class="form-check">
                                    <input class="form-check-input create-tag-cb" type="checkbox" value="@tag.TagId" id="create_tag_@tag.TagId" />
                                    <label class="form-check-label small" for="create_tag_@tag.TagId">
                                        #@tag.TagName
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="createNewsStatus" checked />
                        <label class="form-check-label fw-semibold small" for="createNewsStatus">Active / Published</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnSubmitCreateArticle">
                        <i class="bi bi-check-circle me-1"></i> Save & Publish
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EDIT ARTICLE MODAL -->
<div class="modal fade" id="editArticleModal" tabindex="-1" aria-labelledby="editArticleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="editArticleModalLabel">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Edit News Article
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editArticleForm" onsubmit="submitEditArticle(event)">
                <div class="modal-body p-4">
                    <div id="editArticleAlert" class="alert alert-danger d-none py-2 small"></div>
                    <input type="hidden" id="editNewsArticleId" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Headline <span class="text-danger">*</span></label>
                        <input type="text" id="editHeadline" class="form-control" required maxlength="150" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Secondary Title / Subhead</label>
                        <input type="text" id="editNewsTitle" class="form-control" maxlength="400" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Category <span class="text-danger">*</span></label>
                            <select id="editCategoryId" class="form-select" required>
                                <option value="">-- Select Category --</option>
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat.CategoryId">@cat.CategoryName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">News Source</label>
                            <input type="text" id="editNewsSource" class="form-control" maxlength="400" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">News Content</label>
                        <textarea id="editNewsContent" class="form-control" rows="5" maxlength="4000"></textarea>
                    </div>

                    <!-- Tags Checkboxes -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small d-block">Tags Selection</label>
                        <div class="border rounded p-3 bg-light d-flex flex-wrap gap-3" style="max-height: 120px; overflow-y: auto;">
                            @foreach (var tag in tags)
                            {
                                <div class="form-check">
                                    <input class="form-check-input edit-tag-cb" type="checkbox" value="@tag.TagId" id="edit_tag_@tag.TagId" />
                                    <label class="form-check-label small" for="edit_tag_@tag.TagId">
                                        #@tag.TagName
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="editNewsStatus" />
                        <label class="form-check-label fw-semibold small" for="editNewsStatus">Active / Published</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnSubmitEditArticle">
                        <i class="bi bi-check-circle me-1"></i> Update Article
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@using System.Text.Encodings.Web
@section Scripts {
    <script>
        const createArticleModal = new bootstrap.Modal(document.getElementById('createArticleModal'));
        const editArticleModal = new bootstrap.Modal(document.getElementById('editArticleModal'));

        function openCreateModal() {
            document.getElementById('createArticleForm').reset();
            document.getElementById('createNewsStatus').checked = true;
            $('.create-tag-cb').prop('checked', false);
            $('#createArticleAlert').addClass('d-none').text('');
            createArticleModal.show();
        }

        async function submitCreateArticle(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitCreateArticle');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Saving...';

            const selectedTagIds = [];
            $('.create-tag-cb:checked').each(function () {
                selectedTagIds.push(parseInt($(this).val()));
            });

            const catVal = document.getElementById('createCategoryId').value;
            const payload = {
                headline: document.getElementById('createHeadline').value.trim(),
                newsTitle: document.getElementById('createNewsTitle').value.trim() || null,
                newsContent: document.getElementById('createNewsContent').value.trim() || null,
                newsSource: document.getElementById('createNewsSource').value.trim() || null,
                categoryId: catVal ? parseInt(catVal) : null,
                newsStatus: document.getElementById('createNewsStatus').checked,
                tagIds: selectedTagIds
            };

            try {
                const response = await fetch('/NewsArticles/Create', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                if (response.ok && result.success) {
                    createArticleModal.hide();
                    Swal.fire({
                        icon: 'success',
                        title: 'Published!',
                        text: result.message || 'News article created successfully!',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => location.reload());
                } else {
                    $('#createArticleAlert').removeClass('d-none').text(result.message || 'Failed to create article.');
                }
            } catch (err) {
                $('#createArticleAlert').removeClass('d-none').text('Error communicating with server.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Save & Publish';
            }
        }

        async function openEditModal(id) {
            $('#editArticleAlert').addClass('d-none').text('');
            $('.edit-tag-cb').prop('checked', false);

            try {
                const res = await fetch(`/NewsArticles/GetArticle?id=${encodeURIComponent(id)}`);
                if (!res.ok) {
                    Swal.fire('Error', 'Unable to fetch article details.', 'error');
                    return;
                }
                const data = await res.json();
                document.getElementById('editNewsArticleId').value = data.newsArticleId;
                document.getElementById('editHeadline').value = data.headline || '';
                document.getElementById('editNewsTitle').value = data.newsTitle || '';
                document.getElementById('editNewsContent').value = data.newsContent || '';
                document.getElementById('editNewsSource').value = data.newsSource || '';
                document.getElementById('editCategoryId').value = data.categoryId || '';
                document.getElementById('editNewsStatus').checked = data.newsStatus === true;

                if (data.tagIds && Array.isArray(data.tagIds)) {
                    data.tagIds.forEach(tId => {
                        $(`#edit_tag_${tId}`).prop('checked', true);
                    });
                }

                editArticleModal.show();
            } catch (err) {
                Swal.fire('Error', 'Failed to load article.', 'error');
            }
        }

        async function submitEditArticle(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSubmitEditArticle');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Updating...';

            const selectedTagIds = [];
            $('.edit-tag-cb:checked').each(function () {
                selectedTagIds.push(parseInt($(this).val()));
            });

            const catVal = document.getElementById('editCategoryId').value;
            const payload = {
                newsArticleId: document.getElementById('editNewsArticleId').value,
                headline: document.getElementById('editHeadline').value.trim(),
                newsTitle: document.getElementById('editNewsTitle').value.trim() || null,
                newsContent: document.getElementById('editNewsContent').value.trim() || null,
                newsSource: document.getElementById('editNewsSource').value.trim() || null,
                categoryId: catVal ? parseInt(catVal) : null,
                newsStatus: document.getElementById('editNewsStatus').checked,
                tagIds: selectedTagIds
            };

            try {
                const response = await fetch('/NewsArticles/Update', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getAntiForgeryToken()
                    },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                if (response.ok && result.success) {
                    editArticleModal.hide();
                    Swal.fire({
                        icon: 'success',
                        title: 'Updated!',
                        text: result.message || 'News article updated successfully!',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => location.reload());
                } else {
                    $('#editArticleAlert').removeClass('d-none').text(result.message || 'Failed to update article.');
                }
            } catch (err) {
                $('#editArticleAlert').removeClass('d-none').text('Error communicating with server.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Update Article';
            }
        }

        function confirmDeleteArticle(id, headline) {
            Swal.fire({
                title: 'Delete News Article?',
                text: `Are you sure you want to delete "${headline}"?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, Delete',
                cancelButtonText: 'Cancel'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch(`/NewsArticles/Delete?id=${encodeURIComponent(id)}`, {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': getAntiForgeryToken()
                            }
                        });

                        const resJson = await response.json();
                        if (response.ok && resJson.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Deleted!',
                                text: resJson.message || 'Article deleted successfully.',
                                timer: 1500,
                                showConfirmButton: false
                            }).then(() => location.reload());
                        } else {
                            Swal.fire('Error', resJson.message || 'Cannot delete this article.', 'error');
                        }
                    } catch (err) {
                        Swal.fire('Error', 'Unable to delete article.', 'error');
                    }
                }
            });
        }
    </script>
}
